{
  "name": "@maestroqa/ui-box",
  "version": "5.8.0",
  "description": "Blazing Fast React UI Primitive",
  "contributors": [
    "Jeroen Ransijn (https://twitter.com/jeroen_ransijn)",
    "Roland Warmerdam (https://roland.codes)",
    "Meichen Zhou (https://github.com/jfmaggie)",
    "Netto Farah (https://twitter.com/nettofarah)",
    "Matt Shwery (https://github.com/mshwery)"
  ],
  "keywords": [
    "react"
  ],
  "repository": "adtribute/mqa-ui-box",
  "license": "MIT",
  "main": "dist/src/index.js",
  "typings": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "test": "yarn lint && c8 ava",
    "prepublishOnly": "rm -rf dist && yarn run build",
    "dev": "storybook dev -p 9009 --disable-telemetry",
    "build": "tsc",
    "build-storybook": "storybook build -o .out --disable-telemetry",
    "release": "np",
    "benchmark": "node tools/benchmarks/run.mjs",
    "size": "size-limit",
    "coverage": "c8 report --reporter=html",
    "lint": "eslint ."
  },
  "dependencies": {
    "@emotion/hash": "^0.9.2",
    "inline-style-prefixer": "^5.0.4",
    "prop-types": "^15.7.2"
  },
  "peerDependencies": {
    "react": "^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/react-vite": "^10.6.5",
    "@types/enzyme": "^3.9.1",
    "@types/inline-style-prefixer": "^5.0.0",
    "@types/prop-types": "^15.7.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-test-renderer": "^18.3.0",
    "@types/sinon": "^7.0.11",
    "ava": "^6.4.1",
    "c8": "^12.0.0",
    "csstype": "^2.6.4",
    "enzyme": "3.11.0",
    "eslint": "^10.13.0",
    "husky": "^2.2.0",
    "lint-staged": "^10.5.4",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "sinon": "^7.2.7",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.5",
    "ts-node": "^10.9.2",
    "typescript": "4.9.4",
    "vite": "^8.3.5"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "size-limit": [
    {
      "path": "dist/src/index.js",
      "limit": "65 KB",
      "gzip": false,
      "brotli": false
    }
  ],
  "ava": {
    "require": [
      "ts-node/register/transpile-only",
      "./test/_setup"
    ],
    "extensions": {
      "ts": "commonjs",
      "tsx": "commonjs"
    },
    "files": [
      "test/**/*.ts",
      "test/**/*.tsx"
    ],
    "workerThreads": false
  },
  "resolutions": {
    "cheerio": "1.0.0-rc.12"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts",
      "src/**/*.tsx"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "packageManager": "yarn@1.22.22"
}
